# Copy this file to .env and fill in real values before running docker compose.

# --- Who becomes super admin ---
# Whichever email registers first with THIS exact address gets full admin
# access (can deactivate other users, etc). Everyone else who signs up
# (your friends) gets a normal account automatically.
SUPER_ADMIN_EMAIL=you@example.com

# --- Security ---
# Any long random string. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Encryption key for API keys / email passwords stored in the database.
# Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# --- Database (leave as-is for the bundled docker-compose Postgres) ---
DATABASE_URL=postgresql://jobtrack:jobtrack@db:5432/jobtrack

# --- Frontend -> backend URL ---
# If you're deploying on your Tailscale network, this is usually
# something like http://100.x.x.x:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# --- Optional: shared Adzuna fallback key ---
# If set, users get Adzuna results even before connecting their own key.
# Get a free key at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Google AI (Gemini) for inbox email analysis ---
# Get a free key at https://aistudio.google.com/apikey
# Leave blank to disable inbox analysis entirely (manual-add and everything
# else still works fine without it).
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash

# --- Inbox polling (kept conservative for small servers) ---
# How often (minutes) to check connected inboxes, and the max number of
# new emails processed per check. Raise INBOX_POLL_INTERVAL_MINUTES or
# lower INBOX_MAX_EMAILS_PER_POLL if your server is resource-constrained.
INBOX_POLL_INTERVAL_MINUTES=25
INBOX_MAX_EMAILS_PER_POLL=20
# How far back to look the very first time an inbox is connected. A big
# backlog is spread across several poll cycles automatically — it won't
# all hit the server (or the Gemini API) in one shot.
INBOX_BACKFILL_DAYS=30
